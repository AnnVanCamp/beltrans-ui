                "tabPath": "table",
                "tabIcon": "CalendarViewDay",
                "propertiesQueryBlock": "personProperties",
                "paginatedResultsAlwaysExpandRows": false,
                "paginatedResultsRowContentMaxHeight": 190,
                "pagesize": 10,
                "sortBy": null,
                "sortDirection": null
            },
            "instanceConfig": {
                "propertiesQueryBlock": "personProperties",
