    "facets": {
        "prefLabel": {
            "sortByPredicate": "schema:name"
        },
        "nationality": {
            "containerClass": "five",
            "facetType": "list",
            "filterType": "uriFilter",
            "facetLabelPredicate": "skos:prefLabel",
            "predicate": "schema:nationality",
            "facetLabelFilter": "FILTER(LANG(?prefLabel_) = 'en')",
            "sortByPredicate": "schema:nationality/skos:prefLabel",
            "searchField": true,
            "sortButton": true,
            "sortBy": "instanceCount",
            "sortDirection": "desc",
            "pieChartButton": true
        },
        "gender": {
            "containerClass": "five",
            "facetType": "list",
            "filterType": "uriFilter",
